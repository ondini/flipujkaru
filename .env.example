# ====== Stripe klíče ======
# Stripe Dashboard → Developers → API keys.
# POZOR: STRIPE_SECRET_KEY je tajný — NIKDY nedávej do frontendu ani do gitu.
# Lokálně dej TEST klíč (sk_test_…); na Cloudflare do env proměnných dej LIVE (sk_live_…).
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ====== Stripe Price ID (lokální TEST override) ======
# Ceny nejsou tajné (smí do prohlížeče přes VITE_). LIVE ceny jsou zapečené
# jako výchozí v src/config/billing.js — produkce jede na nich. Tyhle TEST
# hodnoty přebijí ceny JEN lokálně (do CD buildu se nedostanou).
VITE_STRIPE_PRICE_MONTHLY=price_test_monthly_xxx
VITE_STRIPE_PRICE_QUARTERLY=price_test_4months_xxx
VITE_STRIPE_PRICE_YEARLY=price_test_yearly_xxx

# ====== Supabase ======
# Supabase → Project Settings → API.
# URL a ANON klíč jsou veřejné (smí do prohlížeče přes VITE_).
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJxxx
# SERVICE ROLE klíč je TAJNÝ — pouze pro server (api/), nikdy do frontendu!
SUPABASE_SERVICE_ROLE_KEY=eyJxxx

# ====== Algdash API („Doporučené flipy") ======
# Server-side proxy (functions/api/deals/) na algdash API. Není tajné —
# jen se přes proxy obchází CORS zámek algdash API na jeho vlastní doménu.
# Bez nastavení se použije výchozí https://fkalgapi.flipujkaru.cz.
ALGDASH_API_BASE=https://fkalgapi.flipujkaru.cz
